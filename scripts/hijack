#!/usr/bin/env bash
set -euo pipefail

REPO="Dietr1ch/ssh-keys"
BRANCH="master"

BASE="https://raw.githubusercontent.com/${REPO}/${BRANCH}/keys"


# Require curl
command -v curl >/dev/null || { echo "curl not found" >&2; exit 1; }


# Setup ~/.ssh/authorized_keys/
mkdir -p ~/.ssh
chmod 700 ~/.ssh
touch ~/.ssh/authorized_keys
chmod 600 ~/.ssh/authorized_keys

# List the .pub files via the GitHub API, then fetch each one
echo "Listing keys"
for f in $(curl -fsSL "https://api.github.com/repos/${REPO}/contents/keys?ref=${BRANCH}" \
           | grep -o '"name": *"[^"]*\.pub"' \
           | sed 's/.*"name": *"//;s/"//'); do
    echo "Fetching and appending $f"
    curl -fsSL "${BASE}/${f}" >> ~/.ssh/authorized_keys
done

echo "Sorting and de-dupping authorized_keys"
sort -u ~/.ssh/authorized_keys -o ~/.ssh/authorized_keys

echo "Done. Keys in ~/.ssh/authorized_keys:"
grep -c '^ssh-\|^ecdsa-\|^sk-' ~/.ssh/authorized_keys || true
